<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GameFrameX.ProtoExport</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 构建产物（Debug/Release 均同）直接输出到同级 Protobuf/Tools/ 目录，供 Proto2*Export 脚本调用。
         路径相对本 csproj 文件定位，任何人把 Tools + Protobuf 克隆到同级目录即可工作。
         使用 OutputPath（而非 OutDir）以避免被 SDK 默认 output-paths target 覆盖。 -->
    <OutputPath>$(MSBuildThisFileDirectory)../../Protobuf/Tools/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!-- 国际化：为非默认 resx 生成附属程序集（satellite assemblies）。
         默认 Strings.resx 为中性资源（简体中文）；Strings.en.resx 自动产出 en/ProtoExport.resources.dll。
         文案按 CurrentUICulture 自动选择：GUI 宿主切线程 culture 即切换，CLI 跟随系统语言。 -->
    <EmbeddedResourceUseDependentUpon>false</EmbeddedResourceUseDependentUpon>
    <GenerateSatelliteAssemblies>true</GenerateSatelliteAssemblies>
    <SatelliteResourceLanguages>zh-CN;zh;en</SatelliteResourceLanguages>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GameFrameX.Foundation.Options" Version="4.0.2" />
  </ItemGroup>	
</Project>
