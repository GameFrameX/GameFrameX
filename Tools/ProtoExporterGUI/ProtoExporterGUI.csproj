<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/logo.ico</ApplicationIcon>
    <AssemblyName>ProtoExporterGUI</AssemblyName>
    <RootNamespace>ProtoExporterGUI</RootNamespace>
    <AssemblyTitle>ProtoExporterGUI</AssemblyTitle>
    <Product>ProtoExporterGUI</Product>
    <Description>GameFrameX protobuf code generation GUI</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <LangVersion>10</LangVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 移除 PublishTrimmed：ProtoBufMessageHandler 用 Assembly.GetTypes()+Activator.CreateInstance 反射发现 Helper，
         trim 会裁剪掉这些类型导致运行时 MissingMethodException；且 PublishTrimmed 强制 self-contained，
         framework-dependent 单文件发布会报 NETSDK1102。工具场景体积不敏感，保留 PublishSingleFile 即可。 -->
    <!-- 国际化：从 resx 生成强类型类 + 为非默认 resx 生成附属程序集（satellite assemblies）。
         默认 Strings.resx 为中性资源；Strings.<culture>.resx 自动产出 <culture>/ProtoExporterGUI.resources.dll。 -->
    <EmbeddedResourceUseDependentUpon>false</EmbeddedResourceUseDependentUpon>
    <GenerateSatelliteAssemblies>true</GenerateSatelliteAssemblies>
    <!-- 单文件发布默认只保留当前 UI Culture 的附属程序集，显式列出中/英文确保两种语言在发布产物中都可用。 -->
    <SatelliteResourceLanguages>zh-CN;zh;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\logo.icns" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoExport\ProtoExport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProtoExporterGUI.Tests" />
  </ItemGroup>
</Project>
